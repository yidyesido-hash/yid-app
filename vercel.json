{
  "outputDirectory": "public",
  "functions": {
    "api/forms.js": {
      "maxDuration": 60,
      "includeFiles": "lib/**"
    }
  },
  "crons": [
    {
      "path": "/api/forms?action=cron-sync",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/yid-forms.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(cartes\\.css|cartes\\.js|habillage\\.css|espace-habillage\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ]
}